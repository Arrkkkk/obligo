# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit it. See docs/DEVELOPMENT.md for how each service uses these.

# Postgres connection string for the Neon dev branch (pgvector extension
# enabled). Get it from the Neon console: your project -> Connect ->
# "Connection string" (use the pooled connection string, sslmode=require).
# This is the DB *owner* role — apps/core uses it only to run Flyway
# migrations (which need DDL/GRANT privileges), never to serve queries.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require"

# Login password for the obligo_app Postgres role that the app actually
# queries as (see apps/core/src/main/resources/db/migration/V2__*.sql).
# Pick any strong random value the first time — the migration creates the
# role with this password. Neon's owner role has rolbypassrls=true, which
# makes Row Level Security silently do nothing for it regardless of FORCE
# ROW LEVEL SECURITY, so the app must run as a role that doesn't have that
# attribute (blueprint §10.9: "app connects as non-superuser role").
APP_DB_PASSWORD="<choose-a-strong-random-value>"

# Password for the obligo_brain Postgres role (created by migration V11) --
# the role apps/brain's Python code connects as, separate from obligo_app.
# apps/brain runs PyMuPDF/PaddleOCR against untrusted uploaded bytes, so it
# gets its own NOBYPASSRLS role scoped to only sources (read) and segments
# (read/write) -- capping the blast radius of a compromised parsing process
# instead of inheriting obligo_app's much broader grants (see V11's
# comment). Pick any strong random value the first time -- the migration
# creates the role with this password.
BRAIN_DB_PASSWORD="<choose-a-strong-random-value>"

# Shared secret gating apps/core -> apps/brain internal HTTP calls (checked
# by apps/brain's require_internal_service_token dependency). Interim
# mitigation only, not real service auth -- it proves the caller knows this
# value, not that any org_id it sends is a legitimate claim. See CLAUDE.md's
# debt list and platform/security/internal_auth.py's docstring for what's
# still genuinely missing. Pick any strong random value; both services just
# need to agree on it.
BRAIN_SERVICE_TOKEN="<choose-a-strong-random-value>"

# Supabase Storage (§11.1). Get these from the Supabase console: your
# project -> Settings -> API. SUPABASE_SERVICE_ROLE_KEY bypasses RLS
# entirely -- never expose it to the browser, server-side only.
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_STORAGE_BUCKET="sources"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# Upstash Redis (REST API, not a raw redis:// URL — no local Redis process
# needed). Get both from the Upstash console: your database -> REST API
# section. Not yet consumed by any service as of Phase 1.
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-rest-token>"

# Google OAuth2 client for sign-in (§10.2). Google Cloud Console -> APIs &
# Services -> Credentials -> Create Credentials -> OAuth client ID -> Web
# application. Authorized redirect URI must be exactly
# http://localhost:8080/login/oauth2/code/google. Consent screen: External,
# Testing mode, scopes openid/email/profile. If unset, core boots fine but
# oauth2Login is simply not wired up (see GoogleOAuthClientRegistrationConfig).
GOOGLE_CLIENT_ID="<your-google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-oauth-client-secret>"

# Where core redirects the browser after a successful sign-in (apps/web).
WEB_APP_URL="http://localhost:3000"
