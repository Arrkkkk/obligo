# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit it. See docs/DEVELOPMENT.md for how each service uses these.

# Postgres connection string for the Neon dev branch (pgvector extension
# enabled). Get it from the Neon console: your project -> Connect ->
# "Connection string" (use the pooled connection string, sslmode=require).
# This is the DB *owner* role — apps/core uses it only to run Flyway
# migrations (which need DDL/GRANT privileges), never to serve queries.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require"

# Login password for the obligo_app Postgres role that the app actually
# queries as (see apps/core/src/main/resources/db/migration/V2__*.sql).
# Pick any strong random value the first time — the migration creates the
# role with this password. Neon's owner role has rolbypassrls=true, which
# makes Row Level Security silently do nothing for it regardless of FORCE
# ROW LEVEL SECURITY, so the app must run as a role that doesn't have that
# attribute (blueprint §10.9: "app connects as non-superuser role").
APP_DB_PASSWORD="<choose-a-strong-random-value>"

# Upstash Redis (REST API, not a raw redis:// URL — no local Redis process
# needed). Get both from the Upstash console: your database -> REST API
# section. Not yet consumed by any service as of Phase 1.
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-rest-token>"
