### === apps/core (Java / Gradle / Spring Boot) === ###
/.gradle/
apps/core/.gradle/
apps/core/build/
apps/core/out/
apps/core/**/build/
apps/core/bin/
!apps/core/**/src/**/build/
apps/core/HELP.md
apps/core/*.log

# Gradle wrapper jar IS committed — do not ignore gradle-wrapper.jar

